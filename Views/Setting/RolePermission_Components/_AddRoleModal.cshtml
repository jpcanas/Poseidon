
<dialog id="modalAddRole" class="modal">
    <div class="modal-box max-w-2xl p-0 overflow-hidden rounded-2xl">
        @Html.AntiForgeryToken()
        <div class="p-6 space-y-5">
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="text-xl font-bold text-base-content" id="roleModalHeader">Add Custom Role</h3>
                    <p class="text-base-content/50 mt-0.5">Customize access by selecting only the permission needed</p>
                </div>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost absolute right-5 top-5">✕</button>
                </form>
            </div>

            <div class="form-control space-y-1.5">
                <label class="label p-0">
                    <span class="label-text font-semibold text-base-content">Role Name</span>
                </label>
                <input type="text"
                       class="input input-bordered w-full focus:outline-none focus:border-primary font-semibold"
                       :class="roleNameError == '' ? '' : 'input-error focus:outline-none focus:border-error' "
                       x-model="form.roleName"
                       x-on:blur="checkRoleName" />
                <div class="label justify-end pb-0">
                    <p class="label-text-alt text-sm text-error" x-text="roleNameError"></p>
                </div>
            </div>

            <div class="form-control space-y-1.5">
                <label class="label p-0">
                    <span class="label-text font-semibold text-base-content">Description</span>
                </label>
                <textarea class="textarea textarea-bordered w-full h-28 focus:outline-none focus:border-primary resize-none"
                          x-model="form.description"></textarea>
            </div>

            <div class="space-y-2">
                <p class="font-semibold text-lg my-2">Permissions</p>

                <div class="border border-base-300 rounded-xl overflow-hidden divide-y divide-base-300 max-h-64 overflow-y-auto">

                    <template x-for="permission in permissions" :key="permission.moduleId">
                        <div>
                            <div class="flex items-start justify-between gap-4 p-4 cursor-pointer select-none hover:bg-base-100 transition-colors"
                                 x-on:click="togglePermission(permission.moduleId)">
                                <div class="flex-1 min-w-0">
                                    <p class="font-semibold text-base-content" x-text="permission.moduleName"></p>
                                    <p class="text-sm text-base-content/50 mt-0.5 leading-snug" x-text="permission.moduleDescription"></p>
                                </div>
                                <input type="checkbox"
                                       class="toggle toggle-primary mt-0.5 shrink-0"
                                       :checked="permission.enabled"
                                       x-on:click.stop="togglePermission(permission.moduleId)" />
                            </div>

                            <div x-show="permission.enabled"
                                 x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 -translate-y-1"
                                 x-transition:enter-end="opacity-100 translate-y-0"
                                 x-transition:leave="transition ease-in duration-150"
                                 x-transition:leave-start="opacity-100 translate-y-0"
                                 x-transition:leave-end="opacity-0 -translate-y-1"
                                 class="bg-base-100 px-4 pb-4 space-y-2">
                                <template x-for="(sub, subIndex) in permission.subModules" :key="subIndex">
                                    <label class="flex items-center gap-3 cursor-pointer">
                                        <input type="checkbox"
                                               class="checkbox checkbox-primary checkbox-sm"
                                               x-model="sub.isAssigned"
                                               x-on:change="toggleSubModule(permission.moduleId)" />
                                        <span class="text-sm text-base-content" x-text="sub.subModuleName"></span>
                                    </label>
                                </template>
                            </div>

                        </div>
                    </template>

                </div>
            </div>

        </div>

        <!-- Modal Footer -->
        <div class="flex justify-end gap-3 px-6 py-4 border-t border-base-300 bg-base-100">
            <button class="btn btn-ghost" x-on:click="closeModal">Cancel</button>
            <button class="btn btn-primary px-6" id="btnSubmitRole" x-on:click="confirmSubmit">
                Create Role
            </button>
        </div>

    </div>
</dialog>

<dialog id="modalConfirmSaveRole" class="modal">
    <div class="modal-box w-11/12 max-w-xl">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" :class="isSubmitting ? 'btn-disabled' : '' ">✕</button>
        </form>

        <h3 class="text-lg font-bold" id="txtConfirmTitle"></h3>
        <p class="py-4" id="txtConfirmMsg"></p>
        <div class="modal-action">
            <form method="dialog">
                <button class="btn" :class="isSubmitting ? 'btn-disabled' : '' ">Close</button>
            </form>
            <button class="btn btn-primary px-6" :class="isSubmitting ? 'btn-disabled' : '' " x-on:click="submitForm">
                <span :class="isSubmitting ? 'loading loading-spinner' : '' "></span>
                <span x-text="isSubmitting ? 'loading' : 'Submit' "></span>
            </button>
        </div>
    </div>
</dialog>

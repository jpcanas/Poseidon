@using Poseidon.Models.ViewModels;

<dialog id="modalManageUser" class="modal">
    @Html.AntiForgeryToken()
    <div class="modal-box p-0 max-w-4xl w-full flex flex-col overflow-hidden" style="max-height: 85vh;">
        <!-- Header Banner -->
        <div class="h-24 flex-shrink-0 bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-700 relative">
            <!-- Close Button -->
            <button class="absolute top-4 right-4 btn btn-circle btn-sm bg-white/20 border-none hover:bg-white/30"
                    :class="loading ? 'btn-disabled' : '' "
                    onclick="closeManageUserModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-white">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Profile Row -->
        <div class="px-8 -mt-7 relative z-10 flex items-end justify-between pb-2 flex-shrink-0">
            <div class="flex items-end gap-4">
                <!-- Avatar -->
                <div class="avatar relative">
                    <div class="w-20 rounded-lg ring ring-white ring-4 bg-white">
                        <img src="~/placeholders/avatar_placeholder.png" alt="Profile" id="profilePicImg"/>
                    </div>
                    @*<button class="absolute -bottom-1 -right-1 btn btn-circle btn-xs bg-primary border-none">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </button>*@
                </div>

                <div class="pb-0">
                    <h2 class="text-xl font-semibold text-neutral" x-text="fullName"></h2>
                    <p class="text-sm text-gray-500" x-text="email"></p>
                </div>
            </div>

            <div id="statusPill">unknown</div>
        </div>


        <!-- Scrollable Body -->
        <div class="flex-1 overflow-y-auto px-8 py-4 space-y-6">
            <div class="mt-5">
                <p class="font-semibold text-lg text-primary my-2">Basic Information</p>
                <div class="form-control">
                    <div class="grid md:grid-cols-2 gap-4 font-medium">
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">Username</span>
                            </div>
                            <input type="text" placeholder=""
                                   x-model="userName"
                                   class="input input-bordered w-full focus:outline-none focus:border-primary font-semibold" />
                            <div class="label justify-end pb-0">
                                <p class="label-text-alt text-sm text-error" x-text="userNameError"></p>
                            </div>
                        </div>
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">First Name <span class="text-error">*</span></span>
                            </div>
                            <input type="text" placeholder=""
                                   x-model="firstName"
                                   class="input input-bordered w-full focus:outline-none focus:border-primary font-semibold"
                                   :class="firstNameError == '' ? '' : 'input-error focus:outline-none focus:border-error' "
                                   x-on:blur="validateNewUser('firstName')" />
                            <div class="label justify-end pb-0">
                                <p class="label-text-alt text-sm text-error" x-text="firstNameError"></p>
                            </div>
                        </div>
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">Middle Name</span>
                            </div>
                            <input type="text" placeholder="" x-model="middleName"
                                   class="input input-bordered w-full focus:outline-none focus:border-primary font-semibold" />
                        </div>
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">Last Name <span class="text-error">*</span></span>
                            </div>
                            <input type="text" placeholder=""
                                   x-model="lastName"
                                   class="input input-bordered w-full focus:outline-none focus:border-primary font-semibold"
                                   :class="lastNameError == '' ? '' : 'input-error focus:outline-none focus:border-error' "
                                   x-on:blur="validateNewUser('lastName')" />
                            <div class="label justify-end pb-0">
                                <p class="label-text-alt text-sm text-error" x-text="lastNameError"></p>
                            </div>
                        </div>
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">Sex <span class="text-error">*</span></span>
                            </div>
                            <select class="select select-bordered w-full focus:outline-none focus:border-primary font-semibold text-base"
                                    :class="selectSexError == '' ? '' : 'select-error focus:outline-none focus:border-error' "
                                    x-model="selectSex"
                                    x-on:blur="validateNewUser('sex')">
                                <option value="" disabled>-- Select</option>
                                @if (ViewBag.BiologicalSexOptions != null)
                                {
                                    foreach (var item in ViewBag.BiologicalSexOptions)
                                    {
                                        <option value="@item.value">@item.text</option>
                                    }
                                }
                                else
                                {
                                    <option value="" disabled>-- No available options</option>
                                }
                            </select>
                            <div class="label justify-end pb-0">
                                <p class="label-text-alt text-sm text-error"></p>
                            </div>
                        </div>
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">Birthdate</span>
                            </div>
                            <input type="text" placeholder="" class="input input-bordered w-full focus:outline-none focus:border-primary" id="dateBirthEdit" />
                            <div class="label justify-end pb-0">
                                <p class="label-text-alt text-sm text-error"></p>
                            </div>
                        </div>
                        <div class="w-full col-span-2">
                            <div class="label pt-0">
                                <span class="label-text">Mobile Number</span>
                            </div>
                            <input type="text" placeholder="" class="input input-bordered w-full focus:outline-none focus:border-primary font-semibold" x-model="mobileNumber" />
                        </div>
                        <div class="w-full col-span-2">
                            <div class="label pt-0">
                                <span class="label-text">Address</span>
                            </div>
                            <input type="text" placeholder="" class="input input-bordered w-full focus:outline-none focus:border-primary font-semibold" x-model="address" />
                        </div>
                    </div>
                </div>
            </div>

            @{
                var roles = ViewBag.Roles as List<RoleVM>;
                var statusList = ViewBag.StatusList as List<UserStatusVM>;
            }

            <div class="mt-6">
                <p class="font-semibold text-lg text-primary my-2">Access Control</p>
                <div class="form-control">
                    <div class="grid md:grid-cols-2 gap-4 font-medium">
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">Role <span class="text-error">*</span></span>
                            </div>
                            <select class="select select-bordered w-full focus:outline-none focus:border-primary font-semibold text-base"
                                    x-model="selectRole"
                                    :class="selectRoleError == '' ? '' : 'select-error focus:outline-none focus:border-error' "
                                    x-on:blur="validateNewUser('role')">
                                <option value="" disabled>-- Select a role</option>
                                @if (roles?.Any() == true)
                                {
                                    foreach (RoleVM role in roles)
                                    {
                                        <option value="@role.RoleId">@role.RoleName</option>
                                    }
                                }
                                else
                                {
                                    <option value="" disabled>-- No available options</option>
                                }
                            </select>
                            <div class="label justify-end pb-0">
                                <p class="label-text-alt text-sm text-error"></p>
                            </div>
                        </div>
                        <div class="w-full">
                            <div class="label pt-0">
                                <span class="label-text">Status <span class="text-error">*</span></span>
                            </div>
                            <select class="select select-bordered w-full focus:outline-none focus:border-primary font-semibold text-base"
                                    x-model="selectStatus"
                                    :class="selectStatusError == '' ? '' : 'select-error focus:outline-none focus:border-error' "
                                    x-on:blur="validateNewUser('status')">
                                <option value="" disabled>-- Select a status</option>
                                @if (statusList?.Any() == true)
                                {
                                    foreach (UserStatusVM status in statusList)
                                    {
                                        <option value="@status.UserStatusId">@status.Name</option>
                                    }
                                }
                                else
                                {
                                    <option value="" disabled>-- No available options</option>
                                }
                            </select>
                            <div class="label justify-end pb-0">
                                <p class="label-text-alt text-sm text-error"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Management -->
            <div>
                <h3 class="font-semibold text-lg text-primary mb-3">Account Management</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-xs text-base-content/50 mb-2">Remove this user from the system.</p>
                        <button class="btn btn-outline btn-error btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                            Delete User
                        </button>
                    </div>
                    <div>
                        <p class="text-xs text-base-content/50 mb-2">Temporarily disable this account. User will be blocked from logging in.</p>
                        <div class="flex items-center gap-3">
                            <input type="checkbox" class="toggle toggle-primary" checked />
                            <span class="text-sm font-medium">Account Enabled</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="modal-action flex-shrink-0 border-t border-base-300 px-8 py-4 flex justify-end gap-3 bg-base-100">
            <div class="flex gap-3">
                <button class="btn" :class="loading ? 'btn-disabled' : '' " onclick="closeManageUserModal()">Close</button>
                <button class="btn btn-primary" type="button" onclick="modalConfirmManageUser.showModal()">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</dialog>

<dialog id="modalConfirmManageUser" class="modal">
    <div class="modal-box w-11/12 max-w-xl">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" :class="loading ? 'btn-disabled' : '' ">✕</button>
        </form>

        <h3 class="text-lg font-bold">Save Changes?</h3>
        <p class="py-4" id="txtConfirmMsg">Do you want to save this update?</p>
        <div class="modal-action">
            <form method="dialog">
                <button class="btn" :class="loading ? 'btn-disabled' : '' ">Close</button>
            </form>
            <button class="btn btn-primary px-6" :class="loading ? 'btn-disabled' : '' " x-on:click="updateUser">
                <span :class="loading ? 'loading loading-spinner' : '' "></span>
                <span x-text="loading ? 'loading' : 'Submit' "></span>
            </button>
        </div>
    </div>
</dialog>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Authentication": {
    "CookieName": "PoseidonCookie",
    "CookieExpireMinutes": 30,
    "UseSlidingExpiration": true,
    "EnableAbsoluteExpiration": false,
    "AbsoluteExpireHours": 8,
    "PasswordResetTokenExpiryMinutes": 30,
    "PasswordResetTokenExpiryHours": 24,
    "AuthScheme": "PoseidonAuth",
    "BaseUrl": "https://localhost:44361"
  },

  "InactivitySetting": {
    "MaxInactiveTimeSeconds": 60, //1800 (30mins)
    "ForcedLogoutTimeSeconds": 30 //30
  },

  "ConnectionStrings": {
    "PoseidonDb": "Host=localhost;Port=5432;Database=PoseidonDb;Username=postgres;Password=Password1"
  },

  "PathBase": "",

  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
